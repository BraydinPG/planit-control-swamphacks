# FORESITE on one Vultr server (T079). Caddy gets and renews the HTTPS certificate.
# SITE_ADDRESS comes from /etc/default/caddy, for example
#   SITE_ADDRESS="64-177-53-1.sslip.io, app.example.com"
# The API and the built frontend share one origin, so the browser never makes a
# cross-origin request.
{$SITE_ADDRESS} {
	encode zstd gzip

	@backend path /api/* /health
	handle @backend {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		root * /srv/foresite/frontend
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

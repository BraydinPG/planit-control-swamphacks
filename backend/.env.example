# PlanIT Control backend configuration.
# Copy to backend/.env and fill in values. Never commit backend/.env or real secrets.
# Owner in brackets: the teammate who consumes the variable and documents its setup.

# --- Database: Tiger Data (PostgreSQL-compatible) [Braydin] ---
# Postgres connection URL from the Tiger Cloud console. Tiger Cloud requires sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# --- Auth0 [Braydin] ---
# Tenant domain, without https:// (for example your-tenant.us.auth0.com).
AUTH0_DOMAIN=
# API identifier (audience) the backend validates in access tokens.
AUTH0_AUDIENCE=
# Local-only development bypass for token checks. Keep false. Never enable in a deployed environment.
# When true, a token-less request from 127.0.0.1 may send X-Dev-Role: crew|supervisor (auth/SETUP.md).
DEV_AUTH_BYPASS=false

# --- Gemini [Rudra] ---
# Server-side API key. Never expose to the frontend.
GEMINI_API_KEY=
# Model id used for briefings, report analysis, notice radius, and instructions.
# Required: there is no default. The team uses gemini-3.5-flash-lite: on the free tier,
# gemini-3.8-flash allows only 20 requests a day. gemini-2.5-flash retires 2026-10-20.
# Current ids: https://ai.google.dev/gemini-api/docs/models.
# If the key or model is missing, Gemini features report unavailable and use deterministic fallbacks.
GEMINI_MODEL=
# Seconds to wait before falling back to deterministic output. Photo analysis needs ~20.
# The notice radius uses at most 10 (the API minimum), because a crew member waits on it.
GEMINI_TIMEOUT_SECONDS=20
# Gemini 3 thinking level. "low" keeps calls to a few seconds; leave empty for models
# without thinking levels.
GEMINI_THINKING_LEVEL=low

# --- Next-day briefings [Braydin] ---
# Generate one briefing per team site at 6 PM site-local time (spec.md section 6).
BRIEFING_SCHEDULE_ENABLED=true
# How often the schedule checks which sites have reached 6 PM.
BRIEFING_CHECK_SECONDS=60
# NWS forecast hours fetched for a briefing; must reach 19:00 the next day.
BRIEFING_FORECAST_HOURS=36

# --- Photo storage: Vultr Object Storage (S3-compatible) [Rudra] ---
# Leave the Vultr values empty in local development to use PHOTO_LOCAL_DIR instead.
VULTR_OBJECT_STORAGE_ENDPOINT=
VULTR_OBJECT_STORAGE_ACCESS_KEY=
VULTR_OBJECT_STORAGE_SECRET_KEY=
VULTR_OBJECT_STORAGE_BUCKET=
# Private local directory for development photo uploads. Keep it out of git.
PHOTO_LOCAL_DIR=./.photos
# Maximum upload size in bytes (5 MB).
PHOTO_MAX_BYTES=5242880
# Seconds a signed Vultr photo link stays valid for an authorized viewer. Objects stay private.
PHOTO_URL_SECONDS=900

# --- Live data feeds [Braydin, ingestion] ---
# NWS requires an identifying User-Agent, for example "PlanIT Control (team-contact@example.com)".
NWS_USER_AGENT=
# Minutes after the last successful fetch before a reading is marked stale.
FEED_STALE_AFTER_MINUTES=60
# Minutes after the last successful fetch before cached readings are dropped and the feed reads unavailable.
FEED_UNAVAILABLE_AFTER_MINUTES=360
# Feed refresh loop (T049B): fetch every feed for every site, store readings, run the rules,
# and rescore. Off by default. One-shot run: python -m app.services.refresh
FEED_REFRESH_ENABLED=false
FEED_REFRESH_SECONDS=300
# Seconds to wait on NHC and USGS requests.
FEED_TIMEOUT_SECONDS=10
# Search radii (miles) for attaching feed events to a site. They are wider than the
# alert-rule distances and are not rule settings.
LIGHTNING_SEARCH_RADIUS_MILES=30
# Minutes of submitted strikes returned to the lightning rule.
LIGHTNING_LOOKBACK_MINUTES=60
# Live NOAA GOES GLM lightning from AWS Open Data. When false or failing, lightning
# falls back to the replay fixture, labeled simulated.
LIGHTNING_LIVE_ENABLED=true
# GOES-East (goes19) and GOES-West (goes18).
GLM_SATELLITES=goes19,goes18
# Seconds between polls. GLM writes one file every 20 seconds.
GLM_POLL_SECONDS=20
# Minutes of GLM files read on a cold start or after a long gap.
GLM_BACKFILL_MINUTES=5
HURRICANE_SEARCH_RADIUS_MILES=300
EARTHQUAKE_SEARCH_RADIUS_MILES=100
FLOOD_GAUGE_SEARCH_RADIUS_MILES=10
# Nearest USGS gauges kept per site.
FLOOD_GAUGE_MAX_GAUGES=3
# Source URLs. The defaults are the public feeds; override only for testing.
NHC_STORMS_URL=https://www.nhc.noaa.gov/CurrentStorms.json
USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
USGS_WATER_URL=https://waterservices.usgs.gov/nwis/iv/

# --- HTTP [Rudra] ---
# Comma-separated origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Prototype rule and score settings [Rudra] ---
# Team-chosen prototype values, not employer, regulatory, or NWS policy.
# Heat index (°F): no points below the threshold, then heat scales from HEAT_MIN_POINTS
# at the threshold up to HEAT_MAX_POINTS at the extreme value.
HEAT_INDEX_THRESHOLD_F=103
HEAT_INDEX_EXTREME_F=125
HEAT_MIN_POINTS=0.5
HEAT_MAX_POINTS=2.0
HEAT_WINDOW_HOURS=12
# Points from the strongest active NWS flood alert.
FLOOD_WARNING_POINTS=2.0
FLOOD_WATCH_POINTS=1.0
# Points while a lightning stop-work alert is active. The 10-mile / 30-minute rule itself is fixed.
LIGHTNING_STOP_WORK_POINTS=3.0
# Points per confirmed crew report with the hazard present, by confirmed severity.
REPORT_LOW_POINTS=0.5
REPORT_MODERATE_POINTS=1.0
REPORT_HIGH_POINTS=1.5
# Hurricane (P1): an NWS Hurricane/Tropical Storm Warning for the site, or an NHC storm center
# within this distance, adds points and sends a "potential hurricane" notice.
HURRICANE_STORM_DISTANCE_MILES=50
HURRICANE_POINTS=2.0
# Earthquake (P1): a USGS event at or above this magnitude within this distance.
EARTHQUAKE_MIN_MAGNITUDE=4.0
EARTHQUAKE_DISTANCE_MILES=25
EARTHQUAKE_POINTS=1.5

# --- Demo seed (T069): python -m app.demo seed ---
# Auth0 user IDs (auth0|...) of the demo crew and supervisor accounts, from
# User Management -> Users. Keep the real values only in your uncommitted backend/.env.
# Empty means placeholder accounts that no one can sign in as.
DEMO_CREW_USER_ID=
DEMO_SUPERVISOR_USER_ID=

# --- Species context (GET /api/sites/{id}/species; docs/SPECIES_CONTEXT.md) ---
# USFWS IPaC needs no key today; it says one will eventually be required.
IPAC_RESOURCES_URL=https://ipac.ecosphere.fws.gov/location/api/resources
CRITHAB_SERVICE_URL=https://services.arcgis.com/QVENGdaPbd4LUkLV/ArcGIS/rest/services/USFWS_Critical_Habitat/FeatureServer
SPECIES_TIMEOUT_SECONDS=20
SPECIES_CACHE_HOURS=24
SPECIES_UNAVAILABLE_AFTER_HOURS=168
SPECIES_FOOTPRINT_HALF_KM=0.5
CRITHAB_WINDOW_HALF_KM=3

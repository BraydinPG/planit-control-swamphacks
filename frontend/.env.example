# FORESITE frontend configuration.
# Copy to frontend/.env.local and fill in values. VITE_ variables are bundled into the
# browser build, so put only public values here. Never put API keys or secrets in this file.

# --- API [Cache; previously Nick] ---
# Empty uses same-origin /api; Vite proxies it to local FastAPI on 127.0.0.1:8000.
# An absolute cross-origin backend requires owner-configured CORS. No demo fallback.
VITE_API_BASE_URL=
# true serves fixture JSON instead of calling the API. Keep true until backend routes are ready.
VITE_USE_FIXTURES=true

# --- Auth0 SPA application (public values) [Braydin] ---
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# Must match AUTH0_AUDIENCE in backend/.env.
VITE_AUTH0_AUDIENCE=
# Local dev only (npm run dev): fake sign-in as crew or supervisor without Auth0.
# Pairs with DEV_AUTH_BYPASS=true in backend/.env. Ignored by production builds. See auth/SETUP.md.
# The integrated application rejects this bypass; use explicit fixture mode for its demo.
VITE_DEV_AUTH_ROLE=
